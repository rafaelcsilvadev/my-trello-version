# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port the API listens on
PORT=3000
# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# PostgreSQL connection URL (required)
DATABASE_URL=postgres://trello:trello@localhost:5432/trello
# HMAC secret that signs access tokens, at least 32 characters (required).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-secret-of-32-chars-or-more
# Access token lifetime: <number><s|m|h|d>, e.g. 15m or 1h
JWT_EXPIRES_IN=1h
# Browser origins allowed to call the API, comma-separated (scheme://host[:port],
# no path or trailing slash). Leave empty to keep CORS disabled.
CORS_ORIGINS=http://localhost:5173
